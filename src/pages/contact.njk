  <!-- Main Content -->
  <section class="section">
    <div class="container">
      <div class="grid-2" style="align-items:flex-start;">
        <div>
          <h2>Come and talk to us</h2>
          <p class="lead">
            Whether you are a health professional, local authority officer, researcher, charity leader, or resident champion, we invite you to join our national mission.
          </p>

          <div style="margin: 2.5rem 0;">
            <h3 style="font-size:1.2rem; margin-bottom:0.5rem;">Direct enquiries</h3>
            <p style="margin-bottom:0.25rem;"><strong>Email:</strong> <a href="mailto:william.bird@intelligenthealth.co.uk" style="color:var(--color-accent-salmon); font-weight:600;">william.bird@intelligenthealth.co.uk</a></p>
            <p><strong>Coalition Co-Chairs:</strong> College of Medicine &amp; British Society of Lifestyle Medicine</p>
          </div>

          <div class="highlight-box">
            <p><strong>Media &amp; policy enquiries:</strong> For parliamentary briefings, press commentary, and conference appearances, please get in touch using the form or direct email.</p>
          </div>
        </div>

        <div>
          <div class="form-card">
            <h3 style="margin-bottom:1.5rem;">Send us a message</h3>
            <form class="contact-form" data-ajax="true">
              <div class="form-group">
                <label class="form-label" for="contact-name">Full Name</label>
                <input type="text" id="contact-name" class="form-control" placeholder="Dr/Mr/Ms Your Name" required>
              </div>

              <div class="form-group">
                <label class="form-label" for="contact-email">Email Address</label>
                <input type="email" id="contact-email" class="form-control" placeholder="you@organisation.org" required>
              </div>

              <div class="form-group">
                <label class="form-label" for="contact-org">Organisation / Role (Optional)</label>
                <input type="text" id="contact-org" class="form-control" placeholder="e.g. NHS Trust, Council, Charity">
              </div>

              <div class="form-group">
                <label class="form-label" for="contact-message">Message</label>
                <textarea id="contact-message" class="form-control" rows="5" placeholder="How would you like to get involved or collaborate?" required></textarea>
              </div>

              <button type="submit" class="btn btn-accent" style="width:100%;">Send message</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
