---
layout: layouts/base.njk
pagination:
  data: collections.team
  size: 1
  alias: m
permalink: "/author-{{ m.slug }}.html"
section: "news"
cta: true
eleventyComputed:
  title: "Blogs from {{ m.name }}"
  description: "{{ m.description }}"
---
{% set posts = collections.blog | byAuthor(m.slug) %}
{% set org = organisations | orgOf(m) %}
  <div class="page-header">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumbs">
        <a href="index.html">Home</a>
        <span class="separator">/</span>
        <a href="blogs.html">Blogs</a>
        <span class="separator">/</span>
        <span class="current">{{ m.name }}</span>
      </nav>
      <h1>Blogs from {{ m.name }}</h1>
      <p class="lead">{{ m.role }}{% if org.name %}, {{ org.name }}{% endif %}</p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      {% if org.description %}
      <div class="card mb-5" style="background-color:var(--color-bg-alt); border-left:4px solid var(--color-accent-salmon);">
        <h2 style="font-size:1.3rem; margin-bottom:0.75rem;">About {{ org.name }}</h2>
        <p style="margin-bottom:{% if org.url %}0.9rem{% else %}0{% endif %};">{{ org.description }}</p>
        {% if org.url %}<a href="{{ org.url }}" class="post-readmore" style="margin-top:0;" rel="noopener">Visit {{ org.name }} &rarr;</a>{% endif %}
      </div>
      {% endif %}

      <div style="display:flex; align-items:center; gap:1.5rem; flex-wrap:wrap; margin-bottom:2.5rem;">
        <img src="assets/images/{{ m.photo }}" alt="{{ m.name }}" width="110" height="110" style="width:110px; height:110px; border-radius:50%; object-fit:cover; object-position:top; box-shadow:var(--shadow-sm);">
        <div>
          <p style="margin:0; font-family:var(--font-display); font-weight:800; font-size:1.15rem;">{{ m.name }}</p>
          <p style="margin:.15rem 0 0; color:var(--hu-text-muted);">{{ m.role }}{% if org.name %} &bull; {{ org.name }}{% endif %}</p>
          <p style="margin:.75rem 0 0;"><a href="team.html" class="post-readmore" style="margin-top:0;">&larr; Back to our team</a></p>
        </div>
      </div>

      {% if posts.length %}
      <div class="grid-3">
        {% for p in posts %}{% include "partials/postcard.njk" %}
        {% endfor %}
      </div>
      {% else %}
      <div class="card" style="text-align:center; padding:3.5rem 2rem; background-color:var(--color-bg-alt);">
        <h2 style="margin-bottom:0.75rem;">No blogs yet</h2>
        <p style="color:var(--hu-text-muted); max-width:42ch; margin:0 auto 1.75rem;">{{ m.name }} has not written any blogs yet. When they publish something, it will appear here.</p>
        <a href="blogs.html" class="btn btn-outline">Browse all blogs</a>
      </div>
      {% endif %}
    </div>
  </section>
