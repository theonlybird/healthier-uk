---
layout: layouts/base.njk
---
  <div class="page-header">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumbs">
        <a href="index.html">Home</a>
        {%- for crumb in breadcrumbs %}
        <span class="separator">/</span>
        <a href="{{ crumb.url }}">{{ crumb.label }}</a>
        {%- endfor %}
        <span class="separator">/</span>
        <span class="current">{{ breadcrumb or title }}</span>
      </nav>
      <h1>{{ heading or title }}</h1>
      {% if lead %}<p class="lead">{{ lead }}</p>{% endif %}
    </div>
  </div>

  <section class="section">
    <div class="container {% if not wide %}container-narrow {% endif %}content-body">

      {%- if leadIn %}
      <p class="lead">{{ leadIn }}</p>
      {%- endif %}

      {%- if image %}
      <img src="assets/images/{{ image }}" alt="{{ imageAlt }}">
      {%- endif %}

      {%- if introImage %}
      <div class="grid-2 mb-5" style="align-items:center;">
        <div>
          {% if introHeading %}<h2>{{ introHeading }}</h2>{% endif %}
{{ content | safe }}
        </div>
        <div>
          <img src="assets/images/{{ introImage }}" alt="{{ introImageAlt }}" style="border-radius:var(--radius-lg); box-shadow:var(--shadow-md);">
        </div>
      </div>
      {%- else %}
{{ content | safe }}
      {%- endif %}

      {%- if callout %}
      <div class="highlight-box">
        <p>{{ callout | safe }}</p>
      </div>
      {%- endif %}

      {%- if featureCard %}
      <div class="card mb-4" style="background-color:var(--color-bg-alt); padding:2rem; border-left:4px solid var(--color-accent-salmon);">
        <h3 style="margin-bottom:0.5rem;"><a href="{{ featureCard.url }}" style="text-decoration:none;">{{ featureCard.title }}</a></h3>
        <p style="margin-bottom:1rem; color:var(--color-text-muted);">{{ featureCard.text }}</p>
        <a href="{{ featureCard.url }}" class="btn btn-accent btn-sm">{{ featureCard.buttonLabel }}</a>
      </div>
      {%- endif %}

      {%- if ctaBox %}
      <div style="margin-top:3rem; padding:2rem; background-color:var(--color-bg-alt); border-radius:var(--radius-lg); text-align:center;">
        <h3 style="margin-bottom:0.75rem;">{{ ctaBox.heading }}</h3>
        <p style="margin-bottom:1.5rem;">{{ ctaBox.text }}</p>
        <a href="{{ ctaBox.url }}" class="btn btn-accent">{{ ctaBox.buttonLabel }}</a>
      </div>
      {%- endif %}

      {%- if cards.length %}
      {% if cardsHeading %}<h2 class="mb-4">{{ cardsHeading }}</h2>{% endif %}
      <div class="grid-2">
        {%- for card in cards %}
        <a href="{{ card.url }}" class="card" style="text-decoration:none;">
          <h3 style="color:var(--color-primary-dark); margin-bottom:0.5rem;">{{ card.title }} &rarr;</h3>
          <p style="color:var(--color-text-muted);">{{ card.text }}</p>
        </a>
        {%- endfor %}
      </div>
      {%- endif %}

      {%- if regionsBlock %}
      <h2 class="mb-4" style="margin-top:3.5rem;">Mayoral regions</h2>
      <p style="max-width:60ch; margin-bottom:1.75rem;">Healthier UK works with mayoral and combined authorities leading health creation in their own places. More regions will be added here as they join.</p>
      <div class="grid-2">
        {%- for r in englandRegions %}
        <a href="{{ r.url }}" class="card" style="text-decoration:none;">
          <h3 style="color:var(--color-primary-dark); margin-bottom:0.5rem;">{{ r.name }} &rarr;</h3>
          <p style="color:var(--color-text-muted); margin-bottom:0.35rem;"><strong>{{ r.authority }}</strong></p>
          <p style="color:var(--color-text-muted);">{{ r.summary }}</p>
        </a>
        {%- endfor %}
      </div>
      {%- endif %}

      {%- if backHref or nextHref %}
      <div style="margin-top:3rem; padding-top:2rem; border-top:1px solid var(--color-border); display:flex; justify-content:space-between; align-items:center; gap:1rem; flex-wrap:wrap;">
        {% if backHref %}<a href="{{ backHref }}" class="btn btn-outline">&larr; {{ backLabel }}</a>{% endif %}
        {% if nextHref %}<a href="{{ nextHref }}" class="btn {{ nextClass or 'btn-accent' }}">{{ nextLabel }}</a>{% endif %}
      </div>
      {%- endif %}

    </div>
  </section>
