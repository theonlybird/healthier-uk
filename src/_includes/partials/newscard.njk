<a href="news-{{ p.fileSlug }}.html" class="post-card">
          <div class="post-card-image">
            <img src="assets/images/{{ p.data.cardImage or p.data.image }}" alt="{{ p.data.cardImageAlt or p.data.imageAlt }}" loading="lazy">
          </div>
          <div class="post-card-body">
            <span class="post-date">{{ p.data.date | ukdate }}</span>
            <h3 class="post-title">{{ p.data.title }}</h3>
            <p class="post-excerpt">{{ p.data.summary | safe }}</p>
            <span class="post-readmore">Read full story &rarr;</span>
          </div>
        </a>